{
  "cli": {
    "version": ">= 12.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "ymlee.dev@gmail.com",
        "ascAppId": "6739178024"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "ymlee.dev@gmail.com",
        "ascAppId": "6739178024"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "production"
      }
    }
  }
}
