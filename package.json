{
  "name": "keeper",
  "main": "expo-router/entry",
  "private": true,
  "type": "module",
  "version": "1.3.17",
  "scripts": {
    "postinstall": "pnpm run prebuild",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:device": "expo run:android --device",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "update:production": "eas update --branch production --message \"Publish to Production\"",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "rm -rf pnpm-lock.yaml ios android node_modules .expo build",
    "icon": "svgr --config-file .svgrrc --typescript --native --icon --out-dir src/shared/ui/icons src/assets/icons",
    "prepare": "husky"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@mj-studio/react-native-naver-map": "2.7.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-native-kakao/core": "2.4.5",
    "@react-native-kakao/user": "2.4.5",
    "@react-native-seoul/naver-login": "4.2.4",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.0",
    "@sentry/react-native": "^7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tamagui/config": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "@tamagui/toast": "1.144.4",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.10.0",
    "buffer": "^6.0.3",
    "burnt": "^0.13.0",
    "dayjs": "^1.11.13",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.8",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "jotai": "^2.11.3",
    "lottie-react-native": "7.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.55.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
