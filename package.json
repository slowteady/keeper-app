  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@dev-plugins/react-query": "~0.4.0",
    "@faker-js/faker": "^9.3.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.17",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
