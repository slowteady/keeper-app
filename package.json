{
  "name": "keeper",
  "main": "expo-router/entry",
  "private": true,
  "type": "module",
  "version": "1.3.12",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "update:production": "eas update:publish --branch production --message \"Publish to Production\"",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "rm -rf pnpm-lock.yaml ios android node_modules .expo build",
    "icon": "svgr --config-file .svgrrc --typescript --native --icon --out-dir src/shared/components/_atoms/icons src/assets/icons"
  },
